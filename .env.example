# Network: testnet (chain 10143) for development, mainnet (chain 143) to settle in real AUSD.
NETWORK=testnet

# Filled in by `npm run deploy`.
PAYOUTS_ADDRESS=
TOKEN_ADDRESS=
START_BLOCK=0

# Deploy key. Never commit this. Use a key that holds nothing but gas.
PRIVATE_KEY=

# Server
PORT=8787
HOST=127.0.0.1
DB_PATH=remi.db
POLL_MS=2000
LOG_CHUNK=2000

# Assistant. Without a key the assistant answers from locally computed figures
# instead of failing, so the app works with this unset.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0905-preview
