# Network: testnet (chain 10143) for development, mainnet (chain 143) to settle in real AUSD.
NETWORK=testnet

# Filled in by `npm run deploy`.
PAYOUTS_ADDRESS=
TOKEN_ADDRESS=
START_BLOCK=0

# Deploy key. Used only by scripts/deploy.mjs; never put it on Render.
PRIVATE_KEY=
# Contract admin that attests businesses before their payouts count in Passport.
# Use a dedicated multisig in production. Defaults to the deployer in the script.
PAYOUTS_ADMIN=

# Server
PORT=8787
HOST=127.0.0.1
TRUST_PROXY=false
# Used only by the server indexer/faucet. This may be a provider URL with a
# credential and is never sent to the browser.
RPC_URL=
# Optional browser RPC URL returned by /api/config. It must be public,
# credential-free and CORS-accessible; blank uses the selected chain default.
PUBLIC_RPC_URL=
DB_PATH=remi.db
POLL_MS=2000
LOG_CHUNK=2000
# The API only publishes blocks after this many confirmations (0 locally).
INDEX_FINALITY_BLOCKS=2
# Canonical block hashes checked on every pass to remove a reorged suffix.
REORG_LOOKBACK_BLOCKS=128

# Browser origins allowed to call the API. Comma-separated; do not use *.
CORS_ORIGINS=http://localhost:5173

# Assistant. Remote model calls are off even if a key exists. Turn them on only
# behind an authenticated edge rate limit and a provider spending cap; local
# summaries work without a key. The edge, not the browser, must inject
# ASSISTANT_EDGE_TOKEN. Enabling remote calls without all three values fails at
# startup, and the API enforces the durable daily request ceiling in SQLite.
KIMI_API_KEY=
KIMI_REMOTE_ENABLED=false
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0905-preview
ASSISTANT_EDGE_TOKEN=
KIMI_DAILY_REQUEST_LIMIT=
ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_LIMIT_PER_IP=5
ASSISTANT_RATE_WINDOW_MS=60000
ASSISTANT_MAX_CONCURRENT=4
ASSISTANT_MAX_BUCKETS=10000
